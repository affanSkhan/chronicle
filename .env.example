# Local Docker Compose settings only. Do not put production credentials in the repository.
POSTGRES_PASSWORD=chronicle-local-only
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=300
ENABLE_PDF_OCR=true
PDF_OCR_MAX_PAGES=50
PDF_OCR_DPI=150
PDF_OCR_MIN_TEXT_CHARS=40
PDF_OCR_LANGUAGE=eng
ENABLE_SCHEDULED_MONITORING=true
SOURCE_MONITOR_POLL_SECONDS=60
SOURCE_MONITOR_BATCH_SIZE=20
JWT_SECRET_KEY=development-only-change-this-secret-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Default free model provider: Groq OpenAI-compatible API. Keep keys server-side.
# Create a free key at https://console.groq.com/keys.
LLM_API_KEY=
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# OpenAlex has a free daily API budget; a free key raises the budget 10x.
OPENALEX_API_KEY=

# Legacy aliases for existing setups. OpenAI API use is billed separately from ChatGPT.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=

# Optional dense retrieval. Configure a dedicated OpenAI-compatible embedding provider;
# embedding credentials are kept separate from generation credentials. Empty = BM25 only.
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_MODEL=

# Run "inline" for Vercel/one-process demos. Docker Compose defaults to a dedicated database worker.
RESEARCH_EXECUTION_MODE=inline
RESEARCH_WORKER_POLL_SECONDS=2
RESEARCH_WORKER_HEARTBEAT_SECONDS=15
RESEARCH_WORKER_STALE_AFTER_SECONDS=180

# Optional private S3-compatible storage for ORIGINAL uploaded PDF bytes. Empty = local filesystem.
DOCUMENT_STORAGE_BACKEND=local
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
