APP_NAME=Chronicle API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://chronicle:chronicle-local-only@localhost:5432/chronicle
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=300
ENABLE_PDF_OCR=true
PDF_OCR_MAX_PAGES=50
PDF_OCR_DPI=150
PDF_OCR_MIN_TEXT_CHARS=40
PDF_OCR_LANGUAGE=eng
ENABLE_SCHEDULED_MONITORING=false
SOURCE_MONITOR_POLL_SECONDS=60
SOURCE_MONITOR_BATCH_SIZE=20
RESEARCH_EXECUTION_MODE=inline
RESEARCH_WORKER_POLL_SECONDS=3
RESEARCH_WORKER_HEARTBEAT_SECONDS=15
RESEARCH_WORKER_STALE_AFTER_SECONDS=180
UPLOAD_DIR=uploads
JWT_SECRET_KEY=development-only-change-this-secret-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Default free model provider: Groq OpenAI-compatible API. Keep keys server-side.
# Create a free key at https://console.groq.com/keys.
LLM_API_KEY=
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# OpenAlex has a free daily API budget; a free key raises the budget 10x.
OPENALEX_API_KEY=

# Optional free-tier scholarly provider; set a key to improve throughput.
SEMANTIC_SCHOLAR_API_KEY=

# Optional dense retrieval using Hugging Face Inference Providers (free quota/limits apply).
# Without HF_TOKEN, Chronicle uses deterministic BM25 lexical retrieval only.
HF_TOKEN=
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HF_EMBEDDING_API_BASE=https://router.huggingface.co/hf-inference/models

# Optional private S3-compatible storage for original PDF bytes (AWS S3 / Cloudflare R2 / compatible).
# Keep all credentials in the deployment environment, never in Git.
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_PREFIX=chronicle-private

# Legacy aliases for existing setups. OpenAI API use is billed separately from ChatGPT.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=
