APP_NAME=Chronicle API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://chronicle:chronicle-local-only@localhost:5432/chronicle
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=300
ENABLE_SCHEDULED_MONITORING=false
SOURCE_MONITOR_POLL_SECONDS=60
SOURCE_MONITOR_BATCH_SIZE=20
UPLOAD_DIR=uploads
JWT_SECRET_KEY=development-only-change-this-secret-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Optional model-assisted claim extraction and synthesis. Keep these server-side.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=
